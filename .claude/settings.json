{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/node_modules/.bin/tsx\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/snapshot-tree.ts\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/node_modules/.bin/tsx\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/snapshot-tree.ts\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/node_modules/.bin/tsx\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.ts\"",
            "timeout": 300
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/node_modules/.bin/tsx\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-check.ts\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
